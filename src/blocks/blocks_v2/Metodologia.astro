---
import type { Component } from "astro";
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import { Badge } from "@/components/starwind/badge";
import { Card } from "@/components/starwind/card";
import IconArrowRight from "@tabler/icons/outline/arrow-right.svg";
import IconCheck from "@tabler/icons/outline/check.svg";

import SectionHeader from "./SectionHeader.astro";

/** Pillar card content */
export interface Pillar {
  /** Icon component (Starwind / tabler svg) */
  icon?: Component;
  /** Card title */
  title?: string;
  /** Card description */
  desc?: string;
  /** Footer link label */
  cta?: string;
}

interface Props extends HTMLAttributes<"section"> {
  eyebrow?: string;
  title?: string;
  lead?: string;
  pillars?: Pillar[];
  /** Small check chips under the grid */
  chips?: string[];
}

const methodologyStyles = tv({
  base: "py-16 md:py-24",
});

const {
  eyebrow = "La metodología",
  title = "Por qué la Sección 8 paga mejor que la renta tradicional",
  lead = "Un sistema repetible, documentado en +100 páginas y validado en cientos de propiedades guiadas por la Academia.",
  pillars = [],
  chips = [],
  class: className,
  ...rest
} = Astro.props;
---

<section class={methodologyStyles({ class: className })} {...rest}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader eyebrow={eyebrow} title={title} lead={lead} />
    <div class="grid gap-6 md:grid-cols-3">
      {
        pillars.map((pillar) => (
          <Card class="group h-full rounded-2xl border-border bg-[#0c111c] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-primary/40">
            {pillar.icon && (
              <span class="flex size-14 items-center justify-center rounded-2xl border border-primary/30 bg-primary/10 text-primary transition group-hover:bg-primary/20">
                <pillar.icon class="size-7"></pillar.icon>
              </span>
            )}
            <h3 class="mt-5 text-xl font-bold text-white">{pillar.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-400">{pillar.desc}</p>
            <span class="mt-5 inline-flex w-full items-center justify-between border-t border-border pt-4 text-sm font-semibold text-primary">
              {pillar.cta}
              <IconArrowRight class="size-4 transition-transform group-hover:translate-x-1"></IconArrowRight>
            </span>
          </Card>
        ))
      }
    </div>
    {
      chips.length > 0 && (
        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          {
            chips.map((chip) => (
              <Badge tone="neutral" appearance="outline" size="lg" class="gap-2 border-border bg-secondary px-4 py-2 text-sm">
                <IconCheck class="size-4 shrink-0 text-primary"></IconCheck>
                {chip}
              </Badge>
            ))
          }
        </div>
      )
    }
  </div>
</section>