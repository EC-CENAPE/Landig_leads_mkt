---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import { Badge } from "@/components/starwind/badge";

import SectionHeader from "./SectionHeader.astro";

/** System step card */
export interface S8Step {
  /** Step number, e.g. "01" */
  n: string;
  title?: string;
  desc?: string;
}

interface Props extends HTMLAttributes<"section"> {
  eyebrow?: string;
  title?: string;
  lead?: string;
  /** URL shown in the browser bar */
  url?: string;
  /** HUD data availability badge */
  hudBadge?: string;
  /** Radar overlay title */
  radarTitle?: string;
  /** Radar overlay summary */
  radarText?: string;
  /** Radar legend labels */
  legend?: string[];
  /** Trend card badge */
  trendBadge?: string;
  /** Trend card title */
  trendTitle?: string;
  /** Trend card description */
  trendDesc?: string;
  /** Trend card corner note */
  trendNote?: string;
  /** Trend chip label */
  trendUp?: string;
  /** Sparkline bar heights (0-100 %) */
  bars?: number[];
  /** 3 steps grid */
  steps?: S8Step[];
  /** Live badge above the headline */
  sectionBadge?: string;
}

const softwareStyles = tv({
  base: "relative overflow-hidden border-t border-border bg-[#05070c] py-16 md:py-24",
});

const {
  eyebrow = "S8Tracker",
  title = 'Tu trabajo no es buscar "la casa perfecta", es tener el sistema que la filtra por ti.',
  lead = "Trabaja en tiempo real con datos del Departamento de Vivienda de EE.UU. (HUD) y te marca los mercados con mayor flujo.",
  url = "app.s8tracker.com/analytics/us-radar",
  hudBadge = "Datos HUD FMR 2026 Actualizados",
  radarTitle = "Algoritmo Predictivo HUD",
  radarText = "Ohio, Michigan, Missouri y Alabama registran los mayores ratios Renta/Precio (1.4% - 1.9%).",
  legend = ["Saturado", "Neutro", "Alto Flujo Neto"],
  trendBadge = "LO MÁS POTENTE",
  trendTitle = "El pronosticador de tendencia a 12 meses",
  trendDesc = "Se recalcula automáticamente con cada actualización de datos HUD para que sepas exactamente cuándo y dónde comprar.",
  trendNote = "Próximos 12 meses",
  trendUp = "Tendencia: AL ALZA",
  bars = [34, 38, 36, 42, 40, 46, 44, 52, 48, 58, 64, 78],
  steps = [],
  sectionBadge = "TU SOFTWARE INCLUIDO • S8Tracker.com (EN VIVO)",
  class: className,
  ...rest
} = Astro.props;
---

<section class={softwareStyles({ class: className })} {...rest}>
  <div class="pointer-events-none absolute -top-24 right-1/4 h-72 w-72 rounded-full bg-primary/5 blur-[100px]"></div>
  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <Badge tone="neutral" appearance="outline" size="lg" class="gap-2.5 border-border bg-secondary px-4 py-2 text-xs font-semibold text-slate-300 sm:text-sm">
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-success"></span>
        </span>
        {sectionBadge}
      </Badge>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{title}</h2>
      {lead !== "" && <p class="mt-4 text-slate-400">{lead}</p>}
    </div>

    <div class="mb-8 overflow-hidden rounded-2xl border border-border bg-[#0a0e18] shadow-2xl">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-5 py-3">
        <div class="flex items-center gap-2">
          <span class="size-3 rounded-full bg-[#ff5f57]"></span>
          <span class="size-3 rounded-full bg-[#febc2e]"></span>
          <span class="size-3 rounded-full bg-[#28c840]"></span>
          <span class="ml-3 rounded-md border border-border bg-black/40 px-3 py-1 font-mono text-[11px] text-slate-400">
            {url}
          </span>
        </div>
        <Badge tone="neutral" appearance="outline" size="md" class="gap-2 border-border text-[11px]">
          <span class="size-1.5 rounded-full bg-primary"></span>
          {hudBadge}
        </Badge>
      </div>
      <div class="p-5">
        <div class="grid gap-5 lg:grid-cols-[1.4fr_1fr]">
          <div class="relative overflow-hidden rounded-xl border border-border bg-black/40">
            <svg viewBox="0 0 600 380" class="h-auto w-full" aria-hidden="true">
              <defs>
                <radialGradient id="radarGlow" cx="50%" cy="45%" r="60%">
                  <stop offset="0%" stop-color="rgba(191,255,4,0.16)"></stop>
                  <stop offset="100%" stop-color="transparent"></stop>
                </radialGradient>
              </defs>
              <rect width="600" height="380" fill="url(#radarGlow)"></rect>
              <g stroke="rgba(148,163,184,0.08)" stroke-width="1">
                <line x1="0" y1="95" x2="600" y2="95"></line>
                <line x1="0" y1="190" x2="600" y2="190"></line>
                <line x1="0" y1="285" x2="600" y2="285"></line>
                <line x1="150" y1="0" x2="150" y2="380"></line>
                <line x1="300" y1="0" x2="300" y2="380"></line>
                <line x1="450" y1="0" x2="450" y2="380"></line>
              </g>
              <path d="M70 300 C150 250, 215 235, 290 210 C360 185, 435 155, 530 100" fill="none" stroke="#0f172a" stroke-width="46" stroke-linecap="round" stroke-linejoin="round" opacity="0.95"></path>
              <circle cx="345" cy="195" r="20" fill="none" stroke="rgba(191,255,4,0.5)" stroke-width="2">
                <animate attributeName="r" values="14;42" dur="2s" repeatCount="indefinite"></animate>
                <animate attributeName="opacity" values="0.8;0" dur="2s" repeatCount="indefinite"></animate>
              </circle>
              <circle cx="300" cy="208" r="9" fill="#0f172a" stroke="#bfff04" stroke-width="2"></circle>
              <circle cx="380" cy="185" r="8" fill="#0f172a" stroke="#bfff04" stroke-width="2"></circle>
              <circle cx="460" cy="150" r="8" fill="#0f172a" stroke="#bfff04" stroke-width="2"></circle>
              <circle cx="345" cy="195" r="6" fill="#bfff04"></circle>
              <circle cx="150" cy="258" r="6" fill="#334155"></circle>
              <circle cx="215" cy="235" r="6" fill="#334155"></circle>
              <circle cx="510" cy="120" r="6" fill="#334155"></circle>
              <circle cx="530" cy="100" r="6" fill="#334155"></circle>
            </svg>
            <div class="pointer-events-none absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-black/50 to-transparent"></div>
            <div class="absolute right-4 bottom-4 left-4">
              <p class="text-[10px] font-bold tracking-widest text-slate-500 uppercase">{radarTitle}</p>
              <p class="mt-1 max-w-md text-sm font-semibold text-white">{radarText}</p>
              <div class="mt-3 flex flex-wrap items-center gap-4 text-[10px] text-slate-400">
                {legend[0] && <span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-[#334155]"></span>{legend[0]}</span>}
                {legend[1] && <span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-slate-500"></span>{legend[1]}</span>}
                {legend[2] && <span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-primary"></span>{legend[2]}</span>}
              </div>
            </div>
          </div>
          <div class="flex flex-col rounded-xl border border-border bg-black/40 p-5">
            <Badge tone="neutral" appearance="outline" size="sm" class="self-start border-primary/30 text-[10px] font-bold text-primary">
              <span class="mr-1 inline-flex size-1.5 rounded-full bg-primary"></span>
              {trendBadge}
            </Badge>
            <h3 class="mt-3 text-lg font-bold text-white">{trendTitle}</h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-400">{trendDesc}</p>
            <div class="mt-4 flex h-20 items-end gap-1.5 pt-2">
              {
                bars.map((h, i) => (
                  <span class={`w-1.5 rounded-full ${i === bars.length - 1 ? "bg-primary" : i >= bars.length - 4 ? "bg-primary/60" : "bg-slate-700"}`} style={`height:${h}%`}></span>
                ))
              }
            </div>
            <div class="mt-4 flex items-center justify-between border-t border-border pt-3">
              <span class="text-[10px] text-slate-500">{trendNote}</span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-primary px-2.5 py-1 text-[10px] font-black text-black">
                <svg viewBox="0 0 24 24" class="size-3" aria-hidden="true"><path d="M12 5l7 9H5z" fill="currentColor"></path></svg>
                {trendUp}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {
      steps.length > 0 && (
        <div class="grid gap-6 md:grid-cols-3">
          {
            steps.map((step) => (
              <div class="rounded-2xl border border-border bg-[#0a0e18] p-6 transition hover:border-primary/30">
                <span class="text-3xl font-black text-primary/70">{step.n}</span>
                <h4 class="mt-2 text-lg font-bold text-white">{step.title}</h4>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">{step.desc}</p>
              </div>
            ))
          }
        </div>
      )
    }
  </div>
</section>