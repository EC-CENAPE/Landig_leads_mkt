---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import { Card } from "@/components/starwind/card";

import SectionHeader from "./SectionHeader.astro";

export interface Testimonial {
  /** Avatar initials */
  initials?: string;
  /** Tailwind classes controlling the avatar tone */
  tone?: string;
  name?: string;
  /** Small badge-like tag under the name */
  tag?: string;
  quote?: string;
}

interface Props extends HTMLAttributes<"section"> {
  eyebrow?: string;
  title?: string;
  lead?: string;
  testimonials?: Testimonial[];
}

const testimonialsStyles = tv({
  base: "py-16 md:py-24",
});

const {
  eyebrow = "Resultados reales",
  title = "Estas historias no son excepciones. Son el sistema.",
  lead = "Cada alumno de la Academia sigue el mismo proceso: mercado ganador, casa correcta, garantía de gobierno.",
  testimonials = [],
  class: className,
  ...rest
} = Astro.props;
---

<section class={testimonialsStyles({ class: className })} {...rest}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader eyebrow={eyebrow} title={title} lead={lead} />
    <div class="grid gap-6 md:grid-cols-3">
      {
        testimonials.map((item) => (
          <Card class="flex h-full flex-col rounded-2xl border-border bg-[#0a0f1a] p-6">
            <div class="flex items-center gap-1 text-amber-400">
              {
                Array.from({ length: 5 }).map(() => (
                  <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true"><path d="M12 17.3l6.2 3.7-1.6-7 5.4-4.6-7.1-.6L12 2.5 9.1 8.8 2 9.4l5.4 4.6-1.6 7z"></path></svg>
                ))
              }
              <span class="ml-1 text-xs font-semibold text-slate-300">5.0</span>
            </div>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-300">"{item.quote}"</p>
            <div class="mt-6 flex items-center gap-3 border-t border-border pt-4">
              <span class={`flex size-10 shrink-0 items-center justify-center rounded-full text-sm font-black ${item.tone}`}>{item.initials}</span>
              <div>
                <p class="text-sm font-bold text-white">{item.name}</p>
                <p class="text-xs font-medium text-primary">{item.tag}</p>
              </div>
            </div>
          </Card>
        ))
      }
    </div>
  </div>
</section>