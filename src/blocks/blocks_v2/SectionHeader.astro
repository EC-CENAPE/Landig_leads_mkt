---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import "./landing.css";

interface Props extends HTMLAttributes<"div"> {
  /** Small eyebrow label shown above the title */
  eyebrow?: string;
  /** Section heading */
  title?: string;
  /** Lead paragraph under the heading */
  lead?: string;
}

const sectionHeaderStyles = tv({
  base: "mx-auto mb-12 max-w-3xl text-center",
});

const { eyebrow = "", title = "", lead = "", class: className, ...rest } = Astro.props;
---

<div class={sectionHeaderStyles({ class: className })} {...rest}>
  {eyebrow !== "" && <p class="s8-eyebrow">{eyebrow}</p>}
  {title !== "" && (
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{title}</h2>
  )}
  {lead !== "" && <p class="mt-4 text-slate-400">{lead}</p>}
</div>