  { initials: "VR", tone: "bg-primary/20 text-primary", name: "Valentina R.", tag: "Estudiante de Diseño • Buenos Aires", quote: "Mi familia y yo tuvimos nuestra sesión de orientación y salimos con todo claro. Llegué a Argentina y CENAPE ya tenía todo listo: residencia, trámites y comunidad." },
  { initials: "DP", tone: "bg-purple-500/20 text-purple-400", name: "Damián P.", tag: "Ingeniería • Córdoba", quote: "Lo mejor es que llegué sintiendo que ya tenía una comunidad. Ninguna duda quedó sin respuesta y nunca me sentí solo en el proceso." },
  { initials: "RF", tone: "bg-emerald-500/20 text-emerald-400", name: "Raúl F.", tag: "Padre de estudiante", quote: "Como papá, valoro que nos incluyeran en la decisión. Hablamos de costos, residencia y seguridad con total transparencia antes de comprometernos." },
