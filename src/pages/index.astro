const collator = new Intl.Collator("es", { numeric: true, sensitivity: "base" });

const mediaUrl = (folder: string, file: string) =>
  `/${encodeURIComponent(folder)}/${encodeURIComponent(file)}`;

const photoRank = (file: string) => {
  const match = file.match(/\((\d+)\)/);
  return match ? Number(match[1]) : 0;
};

const timestamp = (file: string) => {
  const match = file.match(/at (\d{1,2})\.(\d{2})\.(\d{2})\s*(AM|PM)/i);
  if (!match) return 0;

  let hours = Number(match[1]) % 12;
  if (match[4].toUpperCase() === "PM") hours += 12;

  return hours * 3600 + Number(match[2]) * 60 + Number(match[3]);
};

const listMedia = (folder: string, pattern: RegExp, rank?: (file: string) => number) =>
  readdirSync(join(process.cwd(), "public", folder))
    .filter((file) => pattern.test(file))
    .sort(
      (a, b) =>
        timestamp(a) - timestamp(b) ||
        (rank ? rank(a) - rank(b) : 0) ||
        collator.compare(a, b),
    )
    .map((file) => mediaUrl(folder, file));

const photos = (folder: string) => listMedia(folder, /\.(avif|webp|jpe?g|png)$/i, photoRank);
const videos = (folder: string) => listMedia(folder, /\.(mp4|webm|mov)$/i);

