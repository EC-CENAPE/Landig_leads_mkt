---

<Layout
  title="CENAPE Argentina | Agenda tu Sesión de Orientación Personalizada"
  bodyClass="theme-s8"
>
  <meta slot="head" name="description" content="Gracias por registrarte en CENAPE. Conócete como estudiante, descubre tus opciones académicas en Argentina y agenda tu Sesión de Orientación Personalizada." />
  <meta slot="head" name="theme-color" content="#07090e" />
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <Ticker phrases={ticker} />

  <Header
    brandName="CENAPE"
    brandAccent="ARGENTINA"
    brandMark="CE"
    tag="REGISTRO CONFIRMADO"
    ctaText="Agenda tu orientación"
    ctaHref="#agendar"
  />

  <main>
    <Hero
      id="top"
      badge="¡TU REGISTRO ESTÁ CONFIRMADO!"
      titleStart="Agenda tu "
      money="Sesión de Orientación"
      titleMiddle=" "
      range="Personalizada"
      titleEnd=" y da tu primer paso hacia "
      gradientText="estudiar en Argentina"
      description="Gracias por registrarte en CENAPE Argentina. Ahora queremos conocerte a fondo: entender tu proyecto académico y explicarte personalmente cómo vamos a acompañarte para que llegues a Argentina, estudies y construyas tu nueva vida."
      vsl={{
        title: "Conoce la experiencia CENAPE",
        duration: "Un vistazo a la comunidad y las residencias",
        caseBadge: "Estudiantes de toda Latinoamérica",
      }}
      ctaText="Quiero agendar mi orientación"
      ctaHref="#agendar"
      guarantee=""
      proofPrefix=""
    />

    <Stats stats={stats} />

    <Metodologia
      eyebrow="CENAPE Argentina"
      title="¿Qué hace diferente a CENAPE?"
      lead="Estudiar en otro país no debería significar comenzar de cero, solo y sin saber a dónde acudir. CENAPE es una comunidad creada para que estudiar en Argentina sea una experiencia integral: estudios, residencia, acompañamiento y conexión desde el primer día."
      pillars={pillars}
      chips={chips}
    />

    <Software
      eyebrow="Tu plan integral"
      title="No solo estudias en Argentina: construyes tu experiencia completa."
      lead="En CENAPE tu llegada se organiza desde el día uno: opciones académicas, residencia, comunidad y un equipo de personas reales que responden tus dudas."
      url="cenape.com/mi-experiencia"
      sectionBadge="TU PLAN DE ACOMPAÑAMIENTO INCLUIDO • CENAPE.com (EN VIVO)"
      hudBadge="Acompañamiento en vivo"
      radarTitle="Tu experiencia CENAPE"
      radarText="Un lugar donde vivir, una comunidad, orientación académica y un equipo de apoyo: todo lo que necesitas para tu llegada a Argentina."
      legend={["Lo aseguramos", "Te guiamos", "Comunidad"]}
      trendBadge="LO MÁS IMPORTANTE"
      trendTitle="Llegar acompañado, no llegar solo"
      trendDesc="Llegas a un nuevo país, conoces a otros jóvenes y te adaptas con nuestro acompañamiento hasta que Argentina se siente como tu casa."
      trendNote="Tus primeros meses"
      trendUp="Con acompañamiento"
      bars={[34, 38, 36, 42, 40, 46, 44, 52, 48, 58, 64, 78]}
      steps={journeySteps}
    />

    <Propiedades
      eyebrow="Residencias CENAPE"
      title="Mucho más que un lugar donde vivir"
      lead="Vivir. Estudiar. Compartir. Crecer. Nuestras residencias son espacios de alto nivel en zonas universitarias, pensados para que la comunidad estudie, conviva y crezca junto."
      deals={residencias}
      badgeText="RESIDENCIA CENAPE"
      flowLabel="Incluye"
      downLabel="Cuota inicial"
      ctaLabel="Conocer la residencia"
      imgAltPrefix="Residencia CENAPE en "
      footnote="Residencias de referencia ilustrativa. La disponibilidad, los valores y las condiciones de cada residencia se confirman de manera personal en tu Sesión de Orientación."
    />

    <Testimonios
      eyebrow="Vivencias CENAPE"
      title="Cada historia empieza con una conversación"
      lead="Estudiantes y familias que decidieron acompañados, resolvieron todas sus dudas y hoy viven la experiencia CENAPE en Argentina."
      testimonials={testimonials}
    />

    <div class="mx-auto -mt-6 max-w-6xl px-4 pb-16 sm:px-6 md:pb-24">
      <Pruebas
        title="CENAPE EN IMÁGENES"
        subtitle="Residencias y comunidad"
        images={proofs}
      />
    </div>

    <Filtro
      eyebrow="¿Es para ti?"
      title="¿La experiencia CENAPE es para ti?"
      lead="Este proceso no es para todos, ni pretendemos que lo sea."
      yesTitle="Adelante, esto es para ti"
      noTitle="Espera, esto no es para ti"
      yes={fitYes}
      no={fitNo}
      footer="Si te identificas con la columna izquierda, nuestro equipo te lo confirmará en tu Sesión de Orientación Personalizada."
    />

    <Booking
      id="agendar"
      eyebrow="Reserva tu lugar"
      title="Agenda tu Sesión de Orientación Personalizada"
      lead="Elige el día y la hora que mejor se adapten a ti. Tu registro está confirmado y la sesión es personalizada; solo falta reservar tu lugar en el calendario."
      listLabel="¿De qué hablaremos en tu orientación?"
      list={orientationTopics}
      requirementLabel="¿Tus padres participan en la decisión?"
      requirement="Ellos también pueden acompañarte durante la Sesión de Orientación Personalizada. Nuestro equipo les resolverá todas sus dudas sobre el proyecto, la residencia y la experiencia en Argentina."
      callTitle="Sesión de Orientación Personalizada"
      callMeta="45 min • Google Meet"
      availabilityBadge="Cupos limitados"
      brandMark="CE"
      dateTitle="Selecciona fecha y hora:"
      monthLabel="Esta semana"
      days={days}
      zoneLabel="Horario Argentina (GMT-3)"
      slotTitle="Horarios disponibles"
      slots={slots}
      selectedSlot="02:00 PM"
      namePh="Nombre completo"
      emailPh="Correo electrónico"
      phonePh="WhatsApp (+54, +57, +52...)"
      capitalLabel="¿Cuándo planeas comenzar tus estudios?"
      capitalOptions={["Este año", "El próximo año", "Aún lo estoy definiendo"]}
      submitText="Quiero agendar mi orientación"
      formNote="Al enviar, nuestro equipo te contactará para confirmar tu orientación. Nunca compartimos tus datos."
    />
  </main>

  <Footer
    brandName="CENAPE"
    brandAccent="ARGENTINA"
    brandMark="CE"
    blurb="Una comunidad creada para estudiantes que quieren estudiar, vivir y crecer en Argentina."
    badgeText="Agenda tu orientación"
    contacts={[
      { type: "mail", label: "Hola@cenape.com.ar", href: "mailto:Hola@cenape.com.ar" },
      { type: "phone", label: "+54 11 5555-0199", href: "tel:+541155550199" },
      { type: "calendar", label: "Lun - Vie 9am a 7pm" },
    ]}
    legalLabel="Legal"
    legalLinks={["Términos y condiciones", "Política de privacidad", "Aviso de cookies"]}
    copyright="© 2026 CENAPE Argentina. Todos los derechos reservados."
    chatLabel=""
    legalNote="CENAPE Argentina es una organización independiente de orientación y acompañamiento académico. Este sitio no garantiza la admisión a ninguna universidad, ni becas o resultados académicos específicos. La información presentada es de carácter orientativo y puede variar según cada universidad y el contexto de cada estudiante."
  />
</Layout>